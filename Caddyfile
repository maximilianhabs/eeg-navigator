# ┌──────────────────────────────────────────────────────────────────────┐
# │ DIESE DATEI IST AUF DEM SERVER NICHT AKTIV.                          │
# │                                                                      │
# │ Auf neuro-vibe.de läuft ein einziger Caddy, und der gehört zum       │
# │ Dienstwerk-Stack. Er liest ausschliesslich:                          │
# │                                                                      │
# │     ~/nz-dienstplan/Caddyfile                                        │
# │                                                                      │
# │ Änderungen HIER haben keinerlei Wirkung. Wer das Routing von         │
# │ eeg.neuro-vibe.de ändern will, bearbeitet die Datei dort.            │
# │                                                                      │
# │ Ablauf und Fallstricke: nz-dienstplan/docs/RUNBOOK-caddy.md          │
# │ — insbesondere: nach jeder Änderung NEU STARTEN, nicht neu laden.    │
# │                                                                      │
# │ Diese Datei bleibt als Vorlage für einen eigenständigen Betrieb      │
# │ erhalten (etwa auf einem separaten Server).                          │
# └──────────────────────────────────────────────────────────────────────┘

eeg.neuro-vibe.de {
    # Automatisches HTTPS via Let's Encrypt
    encode zstd gzip

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
        -Server
    }

    # Echte Client-IP an Next.js weiterleiten (für Rate-Limiter in der App)
    header_up X-Forwarded-For {remote_host}
    header_up X-Real-IP {remote_host}

    reverse_proxy eeg-navigator:3000
}
